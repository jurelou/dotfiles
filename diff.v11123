     except OSError as exc:
         raise RogerError(f"{path}: {exc.strerror}") from None
     except Exception as exc:
         raise RogerError(f"{path}: invalid HCL syntax\n{exc}") from None
+
+
+def _hooks_of(raws: dict[Path, dict[str, Any]]) -> dict[str, dict[str, Any]]:
+    found = [(path, raw.pop("on_failure")) for path, raw in raws.items() if "on_failure" in raw]
+    if len(found) > 1:
+        raise RogerError(f"one global on_failure only: in {found[0][0]} and {found[1][0]}")

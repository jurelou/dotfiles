+    (conf / "a.hcl").write_text(pipeline("one", files(inbox), DEBUG) + hook)
+    (conf / "b.hcl").write_text(pipeline("two", TIMER, DEBUG))
+    (conf / "env").write_text("NAME=value")  # not .hcl: not read
+    config = load(conf)
+    assert list(config.pipelines) == ["one", "two"]

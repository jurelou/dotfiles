+        ('scheduler {\n work_dir = "/x"\n}\n', f"{conf}/c.hcl: scheduler: replaced by the options"),
+        ('pipeline "three" {\n nope = 1\n}\n', f"{conf}/c.hcl: invalid configuration"),
+    ]:
+        (conf / "c.hcl").write_text(c_hcl)
+        with pytest.raises(RogerError, match=re.escape(error)):

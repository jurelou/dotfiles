+        ("on_failure {\n x = 1\n}\n", f"{conf}/c.hcl: on_failure only accepts job blocks"),
+    ]:
+        (conf / "c.hcl").write_text(c_hcl)
+        with pytest.raises(RogerError, match=re.escape(error)):
+            load(conf)

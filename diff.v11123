+async def test_fail(make_config: Callable[..., Config], inbox: Path, tmp_path: Path) -> None:
+    jobs = """
+    job "parse" {
+      plugin  = "exec"
+      scripts = [["sh", "-c", "cat \\"$1\\" >&2", "sh", "{{ file }}"]]
+    }
+    job "errors" {
+      plugin  = "fail"
+      when    = "{{ 'error' in (data.parse.stdout ~ data.parse.stderr) | lower }}"
+      message = "parse: {{ data.parse.stderr | trim }}"
+    }"""
+    note = f'echo \\"$1\\" > {tmp_path}/failure.txt'
+    hook = f"""
+    on_failure {{
+      job "note" {{
+        plugin  = "exec"
+        scripts = [["sh", "-c", "{note}", "sh", "{{{{ data.failure.error }}}}"]]
+      }}
+    }}"""
+    (inbox / "a.csv").write_text("fine")
+    (inbox / "b.csv").write_text("Error: line 2")
+    engine = await started(make_config(pipeline("p", files(inbox), jobs, hook)))
+    assert await first_runs(engine) == [Status.SUCCESS, Status.FAILED]  # a.csv: errors skipped
+    assert engine.state.runs(Status.FAILED)[0]["error"] == "parse: Error: line 2"  # no type
+    assert (tmp_path / "failure.txt").read_text() == "parse: Error: line 2\n"

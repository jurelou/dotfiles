index 1180ed9..8325b7f 100644
--- a/examples/full.hcl
+++ b/examples/full.hcl
@@ -3,12 +3,7 @@
 # Regexes are HCL strings: backslashes are doubled ("\\d" gives \d).
 # Durations are in seconds.
 
-scheduler {
-  state_db       = "/var/lib/roger/state.db"    # the state directory, kept on the server
-  work_dir       = "/var/lib/roger/work"
-  keep_work_dirs = false   # true: also keep the work directory of a successful run
-  log_file       = "/var/lib/roger/roger.log"   # also logged to stdout (docker logs)
-}
+# The state: the options of roger, --state-db, --work-dir, --keep-work-dirs and --log-file.
 
 # For every pipeline without an on_failure block of its own (invoices, below, has one).
 # Only what every pipeline has: data.failure, data.jobs, the current file when there is one, and
@@ -69,6 +64,12 @@ pipeline "invoices" {
     scripts = [["/opt/roger/scripts/validate.sh", "--client", "{{ client }}", "{{ file }}"]]
   }
 
+  job "errors" {   # validate.sh succeeded but wrote an error: the run fails here, on_failure runs
+    plugin  = "fail"
+    when    = "{{ 'error' in (data.validate.stdout ~ data.validate.stderr) | lower }}"
+    message = "validate.sh wrote an error: {{ (data.validate.stderr or data.validate.stdout) | trim }}"
+  }
+
   job "export" {
     plugin  = "copy"
     timeout = 600   # the whole job: a share that no longer answers fails it after 10 minutes

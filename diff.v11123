-        return Config.model_validate(_normalize(raw))
-    except ValidationError as exc:
-        lines = [f"  {_dotted(e['loc'])}: {e['msg']}" for e in exc.errors()]
-        raise RogerError(f"{path}: invalid configuration\n" + "\n".join(lines)) from None
+        return _hooks(found[0][1], "on_failure") if found else {}
+    except RogerError as exc:
+        raise RogerError(f"{found[0][0]}: {exc}") from None
+
+
+def load_config(path: Path, scheduler: SchedulerConfig) -> Config:
+    files = sorted(path.glob("*.hcl")) if path.is_dir() else [path]
+    if not files:
+        raise RogerError(f"{path}: no .hcl file")
+    raws = {file: _read(file) for file in files}
+    hooks = _hooks_of(raws)
+    pipelines: dict[str, PipelineConfig] = {}
+    where: dict[str, Path] = {}
+    for file, raw in raws.items():
+        try:
+            found = _File.model_validate(_normalize(raw, hooks)).pipelines
+        except ValidationError as exc:
+            lines = [f"  {_dotted(e['loc'])}: {e['msg']}" for e in exc.errors()]
+            raise RogerError(f"{file}: invalid configuration\n" + "\n".join(lines)) from None
+        except RogerError as exc:
+            raise RogerError(f"{file}: {exc}") from None
+        if twice := sorted(found.keys() & where.keys()):
+            raise RogerError(f"pipeline {twice[0]}: in {where[twice[0]]} and {file}")
+        pipelines.update(found)
+        where.update(dict.fromkeys(found, file))
+    if not pipelines:
+        raise RogerError(f"{path}: no pipeline")
+    return Config(scheduler=scheduler, pipelines=pipelines)

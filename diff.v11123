+def render_env(value: Any) -> Any:
+    if isinstance(value, str):
+        only_env = is_template(value) and variables(value) <= {"env"}
+        return render(value, {}, {}) if only_env else value
+    if isinstance(value, list):
+        return [render_env(v) for v in value]
+    if isinstance(value, dict):
+        return {k: render_env(v) for k, v in value.items()}
+    return value
+
+

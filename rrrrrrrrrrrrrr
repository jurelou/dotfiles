import json
import os
from datetime import datetime, timezone

from fastapi import FastAPI, HTTPException, Request
from pydantic import BaseModel

USERS_FILE = os.environ.get("USERS_FILE", "users.json")
LOG_FILE = os.environ.get("LOG_FILE", "requests.jsonl")

with open(USERS_FILE) as f:
    USERS = json.load(f)

# Pas de /docs ni /openapi.json : toute URL autre que POST /user est inconnue
app = FastAPI(docs_url=None, redoc_url=None, openapi_url=None)


class UserBody(BaseModel):
    username: str


@app.middleware("http")
async def log_request(request: Request, call_next):
    response = await call_next(request)
    known = request.method == "POST" and request.url.path == "/user"
    entry = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "event": "user_lookup" if known else "unknown_url",
        "ip": request.client.host if request.client else None,
        "method": request.method,
        "path": request.url.path,
        "username": getattr(request.state, "username", None),
        "status": response.status_code,
    }
    with open(LOG_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")
    return response


@app.post("/user")
def get_user(body: UserBody, request: Request):
    request.state.username = body.username
    if body.username not in USERS:
        raise HTTPException(status_code=404)
    return USERS[body.username]









